# Copy to .env (never commit .env). Every value has a safe default for local development.

# --- Accounts -------------------------------------------------------------
# true  = /api/auth/demo-login works for the 3 seeded accounts (fallback when Google login fails)
# false = Google only. Switching is just this one variable.
DEMO_MODE=true
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret
JWT_TTL_MINUTES=720
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorised JavaScript origins: http://localhost:8000 and your https tunnel URL. (Client ID is public.)
GOOGLE_CLIENT_ID=1063826896142-a4af4dkk92q4n191mucerfrh4nelpc3d.apps.googleusercontent.com
# Comma-separated e-mails that become Operators on first Google login. Everyone else is a Student.
OPERATOR_EMAILS=tien.huynh3003@hcmut.edu.vn
# Optional: restrict students to these domains, e.g. hcmut.edu.vn (leave empty for the demo)
ALLOWED_STUDENT_DOMAINS=

# --- Password reset e-mail ---------------------------------------------------
# Use your public app origin (no trailing slash), e.g. https://your-domain.example
# For localhost-only development: http://localhost:8000
PUBLIC_BASE_URL=https://your-public-app-domain
PASSWORD_RESET_LOCAL_URL=http://localhost:8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="Smart E-Mobility Hub <your-gmail-address@gmail.com>"
SMTP_STARTTLS=true

# --- Payments ---------------------------------------------------------------
PAYMENT_SECRET=replace-with-a-random-payment-secret
# VietQR Quick Link: use the receiving bank's BIN or VietQR short code and the
# real beneficiary account. Never commit real receiver details to source control.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# MoMo For Business credentials are server-only. Local tests can use MoMo's
# sandbox; real IPN requires a public HTTPS URL that can reach this backend.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_BASE=https://test-payment.momo.vn
MOMO_PUBLIC_BASE_URL=

# --- Database ---------------------------------------------------------------
# SQLite file. Use :memory: to turn persistence off.
DATABASE_PATH=data/hub.db
PERSIST_INTERVAL_SECONDS=5

# --- Simulator --------------------------------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_SEED=2026
SIMULATOR_INTERVAL=4
SIMULATOR_FAULT_PROBABILITY=0.02
# auto = follow the clock (peaks 7-9h, 16-19h) | on = always rush hour | off = quiet
SIMULATOR_RUSH_HOUR=auto
